{
  "manifest_version": 2,
  "id": "local.emoji-label-guard",
  "version": "1.0.0",
  "name": "表情标签修复",
  "description": "将模型回复句末的内部表情标签转换为真实表情组件，防止描述文字泄漏",
  "author": {
    "name": "hhucz",
    "url": "https://github.com/hhucz"
  },
  "urls": {
    "repository": "https://github.com/hhucz/maibot-emoji-label-guard",
    "homepage": "https://github.com/hhucz/maibot-emoji-label-guard",
    "issues": "https://github.com/hhucz/maibot-emoji-label-guard/issues"
  },
  "license": "MIT",
  "host_application": {
    "min_version": "1.3.12",
    "max_version": "999.999.999"
  },
  "sdk": {
    "min_version": "2.15.0",
    "max_version": "999.999.999"
  },
  "dependencies": [],
  "capabilities": [
    "emoji.get_emotions",
    "emoji.get_by_description"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
